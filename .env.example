# --- App ---
NODE_ENV=production

# --- Database (Coolifyが用意するPostgres接続文字列を貼る) ---
DATABASE_URL=postgresql://polaris:CHANGE_ME@db:5432/polaris

# --- Auth ---
# ログインパスワード（1ユーザー用）
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Cookieの暗号化に使う32文字以上のランダム文字列（例: openssl rand -hex 32）
SESSION_SECRET=CHANGE_ME_TO_RANDOM_32_PLUS_CHARS

# --- AI（任意。未設定でもアプリは動く＝テンプレ出力にフォールバック） ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
